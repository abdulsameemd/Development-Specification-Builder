  "example": {
    "id": "example-leave-balance",
    "label": "Employee Leave Balance Report",
    "state": {
      "project": { "name": "Employee Leave Balance" },
      "types": ["REPORT"],
      "requirement": {
        "text": "Create a report for HR users to view employee leave entitlement, leave taken and remaining leave balance for a selected date range.",
        "objective": "Give HR a single view of leave balances per employee.",
        "users": "HR users",
        "expectedOutput": "ALV list with leave entitlement, leave taken and remaining balance per employee."
      },
      "objects": [
        { "type": "Table", "name": "PA0001", "status": "existing", "purpose": "Employee organizational assignment" },
        { "type": "Table", "name": "PA2001", "status": "existing", "purpose": "Absences (leave taken)" },
        { "type": "Class", "name": "", "status": "existing", "purpose": "Leave calculation" },
        { "type": "Report", "name": "ZHR_LEAVE_BALANCE", "status": "new", "purpose": "Main report" }
      ],
      "rules": [
        { "condition": "Employee has no remaining leave balance.", "behavior": "Show a zero balance and an information message; do not raise an error." },
        { "condition": "User is not authorized for the selected employee.", "behavior": "Exclude the employee from the result." }
      ],
      "acceptance": [
        { "text": "When HR selects a valid employee and date range, the report displays leave entitlement, leave taken and remaining balance." }
      ],
      "details": {
        "REPORT": {
          "inputs": "PERNR – select-option (employee number)\nBEGDA / ENDDA – date range",
          "outputType": ["alv"]
        }
      },
      "quality": {
        "authorization": "yes",
        "authObject": "",
        "cleanCore": "yes",
        "cleanCoreNote": "",
        "dataVolume": "medium",
        "performanceReq": "",
        "testTypes": ["Unit", "Functional", "Integration"],
        "testScenarios": "Valid employee\nInvalid employee\nNo leave balance\nUnauthorized employee"
      }
    }
  }
}
