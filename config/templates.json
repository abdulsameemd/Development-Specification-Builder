 "examples": [
  {
   "id": "fi-ap-ageing",
   "module": "FI",
   "label": "FI-AP: Vendor open items ageing report",
   "state": {
    "project": {
     "name": "FI AP Vendor Ageing"
    },
    "types": [
     "REPORT",
     "CLASS"
    ],
    "requirement": {
     "text": "Create a report for AP accountants that lists open vendor items for a company code and key date and groups the amounts per vendor into ageing buckets (0-30, 31-60, 61-90, >90 days past net due date).",
     "objective": "Month-end review of overdue payables per vendor.",
     "users": "AP accountants (FI-AP)",
     "expectedOutput": "ALV per vendor with one amount column per ageing bucket in company code currency."
    },
    "objects": [
     {
      "type": "Table",
      "name": "BSIK",
      "status": "existing",
      "purpose": "Vendor open items (compatibility view in S/4HANA)",
      "detail": {
       "used": "BUKRS, LIFNR, BELNR, GJAHR, BUZEI, BUDAT, ZFBDT, ZBD1T, DMBTR, SHKZG"
      }
     },
     {
      "type": "Table",
      "name": "LFA1",
      "status": "existing",
      "purpose": "Vendor master (name)",
      "detail": {
       "used": "LIFNR, NAME1"
      }
     },
     {
      "type": "Report",
      "name": "ZFI_AP_AGEING",
      "status": "new",
      "purpose": "Main report",
      "detail": {
       "programType": "Executable program (type 1)",
       "tcode": "ZFI_AGEING",
       "selection": [
        {
         "name": "S_BUKRS",
         "kind": "SELECT-OPTIONS",
         "type": "BSIK-BUKRS",
         "label": "Company code",
         "obligatory": true
        },
        {
         "name": "S_LIFNR",
         "kind": "SELECT-OPTIONS",
         "type": "BSIK-LIFNR",
         "label": "Vendor"
        },
        {
         "name": "P_KEYDT",
         "kind": "PARAMETERS",
         "type": "SY-DATUM",
         "label": "Key date",
         "obligatory": true,
         "default": "SY-DATUM"
        }
       ],
       "logic": "1. AUTHORITY-CHECK F_BKPF_BUK per company code\n2. Call ZCL_FI_AP_AGEING=>GET_AGEING\n3. Display ALV",
       "outputType": [
        "ALV (CL_SALV_TABLE)"
       ],
       "columns": [
        {
         "field": "LIFNR",
         "header": "Vendor",
         "source": "BSIK-LIFNR",
         "props": "key, hotspot → FK03"
        },
        {
         "field": "NAME1",
         "header": "Name",
         "source": "LFA1-NAME1"
        },
        {
         "field": "BUCKET_030",
         "header": "0-30 days",
         "source": "calculated",
         "props": "sum"
        },
        {
         "field": "BUCKET_060",
         "header": "31-60 days",
         "source": "calculated",
         "props": "sum"
        },
        {
         "field": "BUCKET_090",
         "header": "61-90 days",
         "source": "calculated",
         "props": "sum"
        },
        {
         "field": "BUCKET_999",
         "header": "> 90 days",
         "source": "calculated",
         "props": "sum"
        }
       ]
      }
     },
     {
      "type": "Class",
      "name": "ZCL_FI_AP_AGEING",
      "status": "new",
      "purpose": "Ageing calculation",
      "detail": {
       "description": "Reads open items and calculates ageing buckets",
       "modifiers": [
        "FINAL"
       ],
       "methods": [
        {
         "name": "GET_AGEING",
         "description": "Return ageing lines per vendor",
         "visibility": "PUBLIC",
         "level": "static",
         "kind": "functional",
         "params": [
          {
           "kind": "IMPORTING",
           "name": "IT_BUKRS_RANGE",
           "typing": "TYPE RANGE OF",
           "type": "BUKRS"
          },
          {
           "kind": "IMPORTING",
           "name": "IV_KEY_DATE",
           "typing": "TYPE",
           "type": "DATS"
          },
          {
           "kind": "RETURNING",
           "name": "RT_AGEING",
           "typing": "TYPE",
           "type": "ZFI_TT_AP_AGEING",
           "byValue": true
          }
         ],
         "exceptions": [
          {
           "name": "ZCX_FI_AP_AGEING",
           "kind": "class",
           "when": "No company code authorized"
          }
         ],
         "logic": "1. SELECT open items from BSIK for the company codes\n2. Net due date = ZFBDT + ZBD1T\n3. Days overdue = key date − net due date → bucket\n4. Aggregate per vendor"
        }
       ]
      }
     },
     {
      "type": "Structure",
      "name": "ZFI_S_AP_AGEING",
      "status": "new",
      "purpose": "Ageing result line",
      "detail": {
       "description": "Vendor ageing line",
       "fields": [
        {
         "name": "BUKRS",
         "dataElement": "BUKRS",
         "description": "Company code"
        },
        {
         "name": "LIFNR",
         "dataElement": "LIFNR",
         "description": "Vendor"
        },
        {
         "name": "WAERS",
         "dataElement": "WAERS",
         "description": "Currency"
        },
        {
         "name": "BUCKET_030",
         "dataElement": "DMBTR",
         "description": "0-30 days",
         "refField": "WAERS"
        },
        {
         "name": "BUCKET_999",
         "dataElement": "DMBTR",
         "description": "> 90 days",
         "refField": "WAERS"
        }
       ]
      }
     },
     {
      "type": "Table Type",
      "name": "ZFI_TT_AP_AGEING",
      "status": "new",
      "purpose": "Result table",
      "detail": {
       "lineType": "ZFI_S_AP_AGEING",
       "access": "Standard table",
       "keyDefinition": "Standard key"
      }
     }
    ],
    "rules": [
     {
      "condition": "Item is a debit (SHKZG = S) such as a down payment",
      "behavior": "Include with negative sign"
     },
     {
      "condition": "Net due date is after the key date",
      "behavior": "Put the item in the 0-30 bucket"
     }
    ],
    "acceptance": [
     {
      "text": "When the user enters company code 1000 and a key date, the report lists one line per vendor with the open amount split into the four buckets."
     }
    ],
    "quality": {
     "authorization": "yes",
     "authChecks": [
      {
       "object": "F_BKPF_BUK",
       "fields": "BUKRS = company code, ACTVT = 03",
       "where": "AT SELECTION-SCREEN"
      }
     ],
     "dataVolume": "large",
     "performanceReq": "< 60 s for one company code",
     "testTypes": [
      "Unit",
      "Functional"
     ],
     "testScenarios": "Company code with overdue items => amounts per bucket\nVendor without open items => not listed\nCompany code without authorization => message, no data",
     "cleanCore": "yes",
     "cleanCoreNote": ""
    }
   }
  },
  {
   "id": "mm-gr-rfc",
   "module": "MM",
   "label": "MM: Goods receipt RFC for an external WMS",
   "state": {
    "project": {
     "name": "MM Goods Receipt RFC"
    },
    "types": [
     "RFC"
    ],
    "requirement": {
     "text": "An external warehouse system calls SAP to post a goods receipt (movement type 101) for a purchase order. Return the material document number or the error messages.",
     "objective": "Remove manual MIGO postings for the external warehouse.",
     "users": "Technical RFC user of the WMS",
     "expectedOutput": "Material document number + year, or BAPIRET2 messages."
    },
    "objects": [
     {
      "type": "Function Module",
      "name": "BAPI_GOODSMVT_CREATE",
      "status": "existing",
      "purpose": "Standard goods movement BAPI",
      "detail": {
       "used": "GOODSMVT_HEADER, GOODSMVT_CODE = 01, GOODSMVT_ITEM → MATERIALDOCUMENT, RETURN"
      }
     },
     {
      "type": "RFC",
      "name": "Z_MM_WMS_GOODS_RECEIPT",
      "status": "new",
      "purpose": "Remote-enabled wrapper",
      "detail": {
       "functionGroup": "ZMM_WMS",
       "description": "Post GR for a PO from WMS",
       "processing": "Remote-enabled module",
       "importing": [
        {
         "name": "IV_EBELN",
         "typing": "TYPE",
         "type": "EBELN",
         "byValue": true,
         "description": "Purchase order"
        },
        {
         "name": "IV_BUDAT",
         "typing": "TYPE",
         "type": "BUDAT",
         "optional": true,
         "default": "SY-DATUM",
         "byValue": true,
         "description": "Posting date"
        }
       ],
       "exporting": [
        {
         "name": "EV_MBLNR",
         "typing": "TYPE",
         "type": "MBLNR",
         "byValue": true,
         "description": "Material document"
        },
        {
         "name": "EV_MJAHR",
         "typing": "TYPE",
         "type": "MJAHR",
         "byValue": true,
         "description": "Material document year"
        }
       ],
       "tables": [
        {
         "name": "IT_ITEMS",
         "typing": "LIKE",
         "type": "ZMM_S_WMS_GR_ITEM",
         "description": "PO item, quantity, unit, storage location"
        },
        {
         "name": "ET_RETURN",
         "typing": "LIKE",
         "type": "BAPIRET2",
         "description": "Messages"
        }
       ],
       "exceptions": [
        {
         "name": "PO_NOT_FOUND",
         "kind": "classic",
         "when": "EBELN does not exist"
        }
       ],
       "bapiReturn": true,
       "commit": "inside",
       "destination": "Called by WMS middleware via RFC user",
       "rfcType": "sRFC (synchronous)",
       "logic": "1. Validate PO (EKKO/EKPO)\n2. Map IT_ITEMS to GOODSMVT_ITEM (MOVE_TYPE 101, MVT_IND B)\n3. Call BAPI_GOODSMVT_CREATE\n4. BAPI_TRANSACTION_COMMIT on success, ROLLBACK on error"
      }
     }
    ],
    "quality": {
     "authorization": "yes",
     "authChecks": [
      {
       "object": "S_RFC",
       "fields": "RFC_NAME = ZMM_WMS, ACTVT = 16",
       "where": "RFC user role"
      },
      {
       "object": "M_MSEG_BWE",
       "fields": "BWART = 101",
       "where": "by BAPI"
      }
     ],
     "testTypes": [
      "Unit",
      "Integration"
     ],
     "testScenarios": "Valid PO with 2 items => material document returned\nPO already fully received => error in ET_RETURN\nUnknown PO => exception PO_NOT_FOUND",
     "cleanCore": "yes",
     "cleanCoreNote": "BAPI_GOODSMVT_CREATE"
    }
   }
  },
