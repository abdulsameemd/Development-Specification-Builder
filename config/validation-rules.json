{
  "version": 2,
  "mandatory": [
    { "id": "businessRequirement", "label": "Business requirement", "message": "Describe what needs to be built.", "step": 1, "path": "requirement.text", "minLength": 10 },
    { "id": "developmentObject", "label": "Development object", "message": "Pick at least one development object.", "step": 1, "path": "types", "minItems": 1 }
  ],
  "recommended": [
    { "id": "objectSpecs", "label": "Technical design of new / changed objects", "step": 4, "important": true, "types": "*",
      "anyOf": ["specs:all"] },
    { "id": "authorization", "label": "Authorization requirement", "step": 4, "important": true, "types": "*",
      "anyOf": ["quality.authorization"],
      "question": "Whether authority checks are required and which authorization object applies." },
    { "id": "objects", "label": "SAP objects to reuse or create", "step": 3, "important": true, "types": "*",
      "anyOf": ["objects"] },
    { "id": "expectedOutput", "label": "Expected output", "step": 2, "types": ["REPORT", "RFC", "CDS", "ODATA", "FORM"],
      "anyOf": ["requirement.expectedOutput", "object:Report.columns", "object:Report.outputType", "object:RFC.exporting", "object:Function Module.exporting", "object:CDS.elements"],
      "question": "Expected output." },
    { "id": "businessRules", "label": "Key business rules", "step": 2, "types": "*", "anyOf": ["rules"] },
    { "id": "testScenarios", "label": "A few test scenarios", "step": 4, "types": "*", "anyOf": ["quality.testScenarios"] },
    { "id": "dataVolume", "label": "Expected data volume", "step": 4, "types": ["REPORT", "CDS", "ODATA"],
      "anyOf": ["quality.dataVolume", "quality.performanceReq"], "question": "Expected maximum data volume." }
  ]
}
