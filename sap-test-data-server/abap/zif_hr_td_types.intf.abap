"! <p>Test data wrapper – JSON shapes of the /v1 interface (camelCase on the wire, see tests/contract in the server).</p>
INTERFACE zif_hr_td_types PUBLIC.
  TYPES: BEGIN OF ty_status,
           system          TYPE string,
           client          TYPE string,
           allow_listed    TYPE abap_bool,
           user            TYPE string,
           wrapper_version TYPE string,
           release         TYPE string,
           warnings        TYPE STANDARD TABLE OF string WITH EMPTY KEY,
         END OF ty_status,
         BEGIN OF ty_read_request,
           kind        TYPE string,
           object_id   TYPE string,
           object_type TYPE string,
           infotype    TYPE string,
           subtype     TYPE string,
           from        TYPE string,
           to          TYPE string,
         END OF ty_read_request,
         BEGIN OF ty_error,
           code         TYPE string,
           message      TYPE string,
           sap_messages TYPE STANDARD TABLE OF string WITH EMPTY KEY,
         END OF ty_error,
         BEGIN OF ty_error_body,
           error TYPE ty_error,
         END OF ty_error_body.
ENDINTERFACE.
